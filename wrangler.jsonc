{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Times are UTC; Nairobi is UTC+3.
  //  - every 10 min, 07:00-22:59 Nairobi
  //  - hourly during quiet hours, 23:00-06:00 Nairobi
  //  - daily 07:00 Nairobi: round-up of the last 24 h (DAILY_CRON in src/index.ts)
  //  - daily 18:00 Nairobi: the day's near misses (EVENING_CRON in src/index.ts)
  //  - Mondays 08:00 Nairobi: weekly site report (DIGEST_CRON in src/index.ts)
  // The free plan allows 5 cron triggers; all 5 are used.
  "triggers": { "crons": ["*/10 4-19 * * *", "0 20-23,0-3 * * *", "0 4 * * *", "0 15 * * *", "0 5 * * 1"] },

  // Workers AI (free allowance, no card) for scoring jobs against the CV.
  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-scraper",
      // Filled in by `npx wrangler d1 create job-scraper` (see README).
      "database_id": "8e85b785-1eb5-46c6-ad2f-db71155f91a9"
    }
  ],

  "vars": {
    // Comma-separated, whole words in the job title. Empty = everything. Not applied to LinkedIn.
    "INCLUDE_KEYWORDS": "IT, ICT, software, developer, programmer, network, networking, systems administrator, system administrator, sysadmin, cyber, cybersecurity, information security, helpdesk, help desk, service desk, technical support, desktop support, cloud, database, web developer, full stack, fullstack, frontend, front-end, backend, back-end",
    // Comma-separated, whole words. Any match in the title drops the job (all sources).
    "EXCLUDE_KEYWORDS": "business developer, property developer, real estate developer",

    // Optional extra MyJobMag searches. The latest 100 jobs always come from its feed.
    "MYJOBMAG_QUERIES": "",

    // Comma-separated LinkedIn searches. The PC script (pc/linkedin-push.ps1) runs them all,
    // in order, and stops at the first block (HTTP 429), so the last ones are the first to drop.
    // "aquaculture" and "fisheries" are for an extra profile (EXTRA_PROFILES in src/profile.ts).
    "LINKEDIN_KEYWORDS": "software developer, IT support, network engineer, network administrator, network technician, systems administrator, cyber security, aquaculture, fisheries",
    // More searches, 4 per push in turn (each about hourly), after the ones above.
    "LINKEDIN_KEYWORDS_ROTATING": "help desk, service desk, desktop support, IT technician, NOC engineer, ICT officer, field engineer, IT assistant",
    "LINKEDIN_LOCATION": "Kenya",
    // LinkedIn searches the Worker itself makes per run (rotating, 4 s apart). 0 = none:
    // LinkedIn answers Cloudflare's IPs with 429, so a PC pushes results to /linkedin instead.
    "LINKEDIN_PER_RUN": "0",

    // AI scoring against the CV (src/profile.ts). Telegram: /ai on|off, /minscore N.
    "AI_SCORING": "on",
    "MIN_SCORE": "6",
    // Safety cap per day (free allowance covers ~1,000). Over it, keywords are used.
    "AI_DAILY_LIMIT": "600"
  },

  "observability": { "enabled": true }
}
